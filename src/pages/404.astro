<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Page not found — Shane Chang</title>
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>
    try {
      document.documentElement.dataset.theme = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    } catch {}
  </script>
  <style>
    :root { --bg: #fafafa; --ink: #0a0a0a; --ink-soft: #525252; --rule: #e8e8e8; }
    @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg: #0a0a0a; --ink: #fafafa; --ink-soft: #a3a3a3; --rule: #1f1f1f; } }
    [data-theme="dark"] { --bg: #0a0a0a; --ink: #fafafa; --ink-soft: #a3a3a3; --rule: #1f1f1f; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Geist', -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }
    main { max-width: 980px; margin: 0 auto; padding: 64px 20px; }
    .label, nav { font-family: 'Geist Mono', monospace; font-size: 13px; }
    h1 { font-size: clamp(64px, 14vw, 128px); letter-spacing: -0.05em; margin: 64px 0 16px; }
    p { color: var(--ink-soft); line-height: 1.7; }
    nav { display: flex; flex-wrap: wrap; gap: 24px; border-top: 1px solid var(--rule); margin-top: 32px; padding-top: 24px; }
    a { color: var(--ink); text-underline-offset: 4px; }
  </style>
</head>
<body>
  <main>
    <p class="label">shane-chang</p>
    <h1>404</h1>
    <p>This page could not be found. <span lang="zh">页面不存在。</span></p>
    <nav aria-label="Continue browsing">
      <a href="/">Home</a>
      <a href="/resume/en/">Resume</a>
      <a href="/resume/zh/" lang="zh">中文简历</a>
    </nav>
  </main>
</body>
</html>
