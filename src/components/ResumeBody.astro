---
import type { ResumeData } from '../data/resume';
import ExperienceItem from './ExperienceItem.astro';
import Icon from './Icon.astro';

interface Props {
  data: ResumeData;
  lang: 'en' | 'zh';
}

const { data, lang } = Astro.props;

// Identity pillars — the core of "who I am" surfaced as iconified pills.
// Order matters: location anchors the strip, then primary identity, then
// adjacent specialties. Per-language labels keep the tone native.
const identityCopy =
  lang === 'en'
    ? ['Shenzhen', 'Backend', 'AI Agents', 'Full-Stack', 'Data Governance']
    : ['深圳', '后端', 'AI Agent', '全栈', '数据治理'];
const identityIcons = ['map-pin', 'server', 'bot', 'code-2', 'database'] as const;

const heroKicker = lang === 'en' ? '// resume' : '// 简历';

---

<section class="resume-hero fade">
  <div class="resume-hero__content">
    <p class="kicker">{heroKicker}</p>
    <h1>{data.name}</h1>

    <div class="identity-strip">
      {identityCopy.map((label, i) => (
        <span class:list={['pill', { 'pill--primary': i === 1 || i === 2 }]}>
          <Icon name={identityIcons[i]} size={13} />
          <span>{label}</span>
        </span>
      ))}
    </div>

    <div class="contact-strip">
      {data.meta.map((item) => <span class="contact-item">{item}</span>)}
      {data.contacts.map((c) => {
        if (c.type === 'email') {
          return (
            <a class="contact-item is-link" href={`mailto:${c.value}`}>
              <Icon name="mail" size={12} />
              <span>{c.value}</span>
            </a>
          );
        }
        if (c.type === 'phone') {
          return (
            <span class="contact-item">
              <Icon name="phone" size={12} />
              <span>{c.value}</span>
            </span>
          );
        }
        return null;
      })}
    </div>

    <div class="contact-strip contact-strip--social">
      {data.contacts.map((c) => {
        const brand = {
          linkedin: {
            href: `https://www.linkedin.com/in/${c.value}/`,
            icon: '/assets/linkedin.svg',
            label: `in/${c.value}`,
            title: 'LinkedIn',
          },
          github: {
            href: `https://github.com/${c.value}`,
            icon: '/assets/github.svg',
            label: `gh/${c.value}`,
            title: 'GitHub',
          },
        }[c.type as 'linkedin' | 'github'];
        if (!brand) return null;
        return (
          <a
            class="contact-item is-link"
            href={brand.href}
            target="_blank"
            rel="noopener noreferrer"
            title={brand.title}
          >
            <img src={brand.icon} alt="" class="contact-brand" width="13" height="13" />
            <span>{brand.label}</span>
          </a>
        );
      })}
    </div>

    <p class="summary">{data.summary}</p>
  </div>

  <img
    class="resume-hero__avatar"
    src="/assets/avatar.png"
    alt={lang === 'en' ? `${data.name} portrait` : `${data.name} 头像`}
    width="128"
    height="128"
    loading="eager"
    decoding="async"
  />
</section>

<section class="section fade">
  <h2>{data.sectionTitles.education}</h2>
  <div class="body">
    <div class="education">
      <div class="edu-main">
        <div class="edu-row">
          <img src={data.education.schoolLogo} alt={data.education.school} class="school-logo" />
          <span class="school">{data.education.school}</span>
          <span class="degree">{data.education.degree}</span>
          <span class="college">{data.education.college}</span>
        </div>
        {data.education.major && <p class="major">{data.education.major}</p>}
      </div>
      <span class="edu-date">{data.education.date}</span>
    </div>
  </div>
</section>

{(data.publications ?? []).length > 0 && (
  <section class="section fade">
    <h2>{data.sectionTitles.publications}</h2>
    <div class="body">
      {(data.publications ?? []).map((pub) => (
        <article class="pub">
          <h3 class="pub-title">{pub.title}</h3>
          <div class="pub-meta">
            {pub.venue && <span class="pub-venue">{pub.venue}</span>}
            {pub.authorship && <span class="pub-authorship">{pub.authorship}</span>}
          </div>
          <p class="pub-summary">{pub.summary}</p>
          {pub.links && (
            <div class="pub-links">
              {pub.links.map((l) => (
                <a class="pub-link" href={l.url} target="_blank" rel="noopener noreferrer">
                  <span>{l.label}</span>
                  <Icon name="arrow-up-right" size={11} />
                </a>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
)}

<section class="section fade">
  <h2>{data.sectionTitles.experience}</h2>
  <div class="body">
    <div class="timeline">
      {data.experience.map((entry, i) => (
        <ExperienceItem
          entry={entry}
          isFirst={i === 0}
          isLast={i === data.experience.length - 1}
        />
      ))}
    </div>
  </div>
</section>

<style>
  /* Positioning statement — the first thing a recruiter reads. Kept to one
     paragraph; if it needs two, the claim is not sharp enough yet. */
  .summary {
    margin: 22px 0 0;
    max-width: 62ch;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--ink-soft);
  }

  .pub + .pub { margin-top: 22px; }
  .pub-title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
  }
  .pub-meta {
    margin-top: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-family: 'Geist Mono', monospace;
    font-size: 11.5px;
    color: var(--ink-mute);
  }
  .pub-venue { color: var(--accent); }
  .pub-summary {
    margin: 10px 0 0;
    max-width: 68ch;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .pub-links {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 9px;
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    text-decoration: none;
    border: 1px solid var(--rule);
    border-radius: 6px;
    transition: all 0.2s;
  }
  .pub-link svg { color: var(--ink-mute); transition: color 0.2s; }
  .pub-link:hover { color: var(--accent); border-color: var(--accent); }
  .pub-link:hover svg { color: var(--accent); }

  @media print {
    .pub { break-inside: avoid; page-break-inside: avoid; }
    .summary { color: #333 !important; }
    .pub-venue { color: #111 !important; }
    .pub-summary { color: #333 !important; }
    .pub-link { color: #555 !important; border-color: #aaa !important; }
  }

  /* Identity strip — iconified pills, slightly elevated. Two pills are marked
     `pill--primary` (Backend + AI Agents) to anchor the rest visually. */
  .identity-strip {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    font-family: 'Geist Mono', monospace;
    font-size: 12px;
    color: var(--ink-soft);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: 8px;
    letter-spacing: 0.01em;
    transition: all 0.2s;
  }
  .pill svg {
    color: var(--ink-mute);
    flex-shrink: 0;
    transition: color 0.2s;
  }
  .pill:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .pill:hover svg { color: var(--ink); }

  .pill--primary {
    color: var(--ink);
    border-color: var(--ink);
    font-weight: 500;
  }
  .pill--primary svg { color: var(--accent); }

  /* Contact strip — facts and reach-me lines, smaller and quieter. */
  .contact-strip {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    font-family: 'Geist Mono', monospace;
    font-size: 11.5px;
    color: var(--ink-mute);
    letter-spacing: 0.01em;
  }
  .contact-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .contact-item svg {
    color: var(--ink-mute);
    flex-shrink: 0;
  }
  .contact-item .contact-brand {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .contact-item.is-link {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.2s;
  }
  .contact-item.is-link:hover { color: var(--accent); }
  .contact-item.is-link:hover svg { color: var(--accent); }
  .contact-item.is-link:hover .contact-brand { opacity: 1; }

  /* Second row of the contact block — social handles only. Tighter top
     margin so the two strips read as one block, not two unrelated sections. */
  .contact-strip--social { margin-top: 6px; }

  .timeline { display: flex; flex-direction: column; }

  .education {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .edu-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .edu-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .school-logo {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }
  .school {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .degree {
    font-family: 'Geist Mono', monospace;
    font-size: 11px;
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--bg-elev);
  }
  .college {
    font-size: 13.5px;
    color: var(--ink-soft);
  }
  .major {
    font-size: 12.5px;
    color: var(--ink-mute);
    font-family: 'Geist Mono', monospace;
    letter-spacing: 0.01em;
    margin-left: 32px; /* line up with the school name (logo width + gap) */
  }
  .edu-date {
    font-family: 'Geist Mono', monospace;
    font-size: 11.5px;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .identity-strip { gap: 6px; }
    .pill { padding: 6px 10px; font-size: 11px; }
    .contact-strip { gap: 4px 12px; }
    .education { flex-direction: column; align-items: flex-start; }
    .major { margin-left: 0; }
  }

  @media print {
    .pill { background: transparent !important; border-color: #aaa !important; color: #333 !important; }
    .pill--primary { color: #000 !important; border-color: #000 !important; }
    .pill svg, .pill--primary svg { color: #333 !important; }
    .contact-strip { color: #333 !important; }
    .school { color: #000 !important; }
    .degree { background: transparent !important; border-color: #aaa !important; color: #333 !important; }
  }
</style>
