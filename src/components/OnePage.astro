---
/**
 * One-page resume — print-first. Shared by the Chinese and English pages
 * (src/pages/resume/zh-1p.astro, en-1p.astro), which only pick the data.
 *
 * Standalone on purpose: no ResumeLayout, no nav, no grid background. On screen
 * it renders as a single A4 sheet; `@page` makes the PDF exactly that sheet.
 * Content lives in `zhOnePage` / `enOnePage` (src/data/resume.ts).
 *
 * Hierarchy (each level must be visibly distinct from its parent):
 *   L1 section heading    14px / 700, full-width rule
 *   L2 company            13.5px / 700 + logo; role in accent after a divider
 *   L3 project            12.5px / 700, indented under the company, 项目一/二…
 *   L4 tech-stack line    11px, accent label, grey items
 *   L5 bullet             12px grey body; lead-in regular black; numbers semibold
 *
 * Density: if an edit spills onto a second page, cut a bullet before touching
 * type size — nothing below 11px.
 */
import type { OnePageResume } from '../data/resume';
import Icon from './Icon.astro';

interface Props {
  d: OnePageResume;
  lang: 'zh' | 'en';
}
const { d, lang } = Astro.props;

// Language-specific chrome; everything else is data.
const L =
  lang === 'zh'
    ? { html: 'zh-CN', title: `${d.name} · 简历`, avatar: `${d.name} 头像`, stack: '技术栈：' }
    : { html: 'en', title: `${d.name} · Resume`, avatar: `${d.name} portrait`, stack: 'Tech stack: ' };
const projectLabel = (i: number) =>
  lang === 'zh' ? `项目${['一', '二', '三', '四', '五', '六'][i]}：` : `Project ${i + 1} · `;

// `**text**` → <strong>. Input is our own data file, not user content.
// `[text](url)` → link (used to point at things a reader may not know, e.g. Odoo).
const rich = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a class="inline-link" href="$2">$1 ↗</a>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---
<!doctype html>
<html lang={L.html}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{L.title}</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    @page { size: A4; margin: 0; }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    :root { --accent: #1f4f8a; }
    body {
      background: #e9e9e7;
      color: #1c1c1c;
      font-family: 'Geist', -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
      font-size: 12px;
      line-height: 1.46;
      -webkit-font-smoothing: antialiased;
    }
    .sheet {
      position: relative;
      width: 210mm;
      min-height: 297mm;
      margin: 24px auto;
      padding: 8mm 12mm 7mm;
      background: #fff;
      box-shadow: 0 2px 18px rgba(0, 0, 0, 0.12);
    }
    a { color: inherit; text-decoration: none; }
    strong { font-weight: 600; color: #000; white-space: nowrap; }

    /* Header */
    .head { text-align: center; padding: 0 64px; }
    .name { margin: 0; font-size: 21px; font-weight: 700; letter-spacing: 0.12em; line-height: 1.2; }
    .meta, .contacts {
      display: flex; flex-wrap: wrap; justify-content: center;
      gap: 2px 12px; margin-top: 3px; font-size: 11.5px; color: #444;
    }
    .meta > * + *::before { content: '·'; margin-right: 12px; color: #aaa; }
    .contacts { gap: 2px 16px; }
    .contacts > * { display: inline-flex; align-items: center; gap: 4px; }
    .contacts svg, .contacts img { width: 11px; height: 11px; color: #555; flex-shrink: 0; }
    .avatar {
      position: absolute; top: 8.5mm; right: 12mm;
      width: 52px; height: 52px; border-radius: 5px; object-fit: cover; border: 1px solid #ddd;
    }

    /* L1 */
    section { margin-top: 10px; }
    h2 {
      margin: 0 0 5px; padding-bottom: 2px;
      font-size: 14px; font-weight: 700; letter-spacing: 0.16em; color: #111;
      border-bottom: 1.5px solid #222;
    }
    section > :not(h2) { margin-left: 8px; }
    .lang-en h2 { text-transform: uppercase; letter-spacing: 0.1em; font-size: 13px; }
    /* Latin set runs wider per idea than CJK; 11.5px Geist reads like 12px CJK. */
    body.lang-en { font-size: 11.5px; line-height: 1.42; }
    .lang-en .stack { font-size: 10.5px; }
    .summary { margin-top: 0; margin-bottom: 0; color: #333; }

    .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .date { font-family: 'Geist Mono', monospace; font-size: 10.5px; color: #555; white-space: nowrap; }
    .logo { width: 13px; height: 13px; object-fit: contain; vertical-align: -2px; margin-right: 6px; }
    .logo.mono-logo { filter: grayscale(1); }

    .edu { display: inline-flex; align-items: baseline; gap: 10px; }
    .edu-school { font-weight: 700; }
    .edu-detail { color: #444; }

    .os { margin: 0; padding: 0; list-style: none; }
    .os li + li { margin-top: 2px; }
    .os-title { font-weight: 700; color: #111; }
    .os-inline { color: #333; }
    .os-meta { color: #777; font-size: 11px; }
    .os-links { font-family: 'Geist Mono', monospace; font-size: 10.5px; color: var(--accent); white-space: nowrap; }
    .os-links a + a { margin-left: 8px; }

    /* L2 company */
    .job + .job { margin-top: 7px; padding-top: 7px; border-top: 1px solid #e4e4e4; }
    .job-title { font-weight: 700; font-size: 13.5px; color: #111; }
    .job-role { color: var(--accent); font-size: 12px; font-weight: 500; }
    .job-role::before { content: '｜'; color: #999; margin: 0 4px 0 6px; font-weight: 400; }

    /* L3 project */
    .project { margin: 5px 0 0 10px; }
    .project-title { font-weight: 700; font-size: 12.5px; color: #1a1a1a; }

    /* L4 stack */
    /* One line under the company header: what the business actually was. */
    .scope { margin-top: 1px; font-size: 11px; color: #666; }
    .stack { margin-top: 1px; font-size: 11px; color: #666; }
    .stack b { color: var(--accent); font-weight: 600; }

    /* L5 bullets */
    ul.bullets { margin: 2px 0 0; padding-left: 16px; }
    ul.bullets li { margin: 1px 0; color: #444; }
    ul.bullets li::marker { color: #999; }
    ul.bullets li > strong:first-child { font-weight: 400; color: #000; }
    .inline-link { color: var(--accent); border-bottom: 1px solid rgba(31, 79, 138, 0.35); }
    @media print { .inline-link { border-bottom: none; } }
    .job > .stack, .job > ul.bullets { margin-left: 10px; }

    @media print {
      body { background: #fff; }
      .sheet { margin: 0; box-shadow: none; }
    }
    @media screen and (max-width: 820px) {
      .sheet { width: auto; min-height: auto; margin: 0; padding: 20px 16px; box-shadow: none; }
      .avatar { position: static; display: block; margin: 0 auto 8px; }
      .head { padding: 0; }
      .row { flex-wrap: wrap; }
    }
  </style>
</head>
<body class={`lang-${lang}`}>
  <main class="sheet">
    <img class="avatar" src="/assets/avatar.png" alt={L.avatar} width="52" height="52" />
    <header class="head">
      <h1 class="name">{d.name}</h1>
      <div class="meta">{d.meta.map((m) => <span>{m}</span>)}</div>
      <div class="contacts">
        {d.contacts.map((c) => {
          const icon =
            c.icon === 'mail' || c.icon === 'phone' ? <Icon name={c.icon} size={11} />
            : c.icon ? <img src={`/assets/${c.icon}.svg`} alt="" width="11" height="11" />
            : null;
          return c.href ? <a href={c.href}>{icon}{c.label}</a> : <span>{icon}{c.label}</span>;
        })}
      </div>
    </header>

    <section>
      <h2>{d.sectionTitles.summary}</h2>
      <p class="summary">{d.summary}</p>
    </section>

    <section>
      <h2>{d.sectionTitles.education}</h2>
      <div class="edu">
        <span><img class="logo" src={d.education.logo} alt="" /><span class="edu-school">{d.education.school}</span></span>
        <span class="edu-detail">{d.education.detail}</span>
        <span class="date">{d.education.date}</span>
      </div>
    </section>

    <section>
      <h2>{d.sectionTitles.openSource}</h2>
      <ul class="os">
        {d.openSource.map((o) => (
          <li class="row">
            <div>
              <span class="os-title">{o.title}</span>
              {o.inline && <span class="os-inline"> — {o.inline}</span>}
              {o.meta && <span class="os-meta"> · {o.meta}</span>}
            </div>
            <span class="os-links">{o.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>{d.sectionTitles.experience}</h2>
      {d.experience.map((j) => (
        <div class="job">
          <div class="row">
            <div>
              {j.logo && <img class:list={['logo', { 'mono-logo': j.mono }]} src={j.logo} alt="" />}
              <span class="job-title">{j.company}</span>
              <span class="job-role">{j.role}</span>
            </div>
            <span class="date">{j.date}</span>
          </div>
          {j.scope && <div class="scope">{j.scope}</div>}
          {j.stack && <div class="stack"><b>{L.stack}</b>{j.stack}</div>}
          {j.bullets && (
            <ul class="bullets">{j.bullets.map((b) => <li set:html={rich(b)} />)}</ul>
          )}
          {j.projects && j.projects.map((p, i) => (
            <div class="project">
              <div class="project-title">{projectLabel(i)}{p.name}</div>
              <div class="stack"><b>{L.stack}</b>{p.stack}</div>
              <ul class="bullets">{p.bullets.map((b) => <li set:html={rich(b)} />)}</ul>
            </div>
          ))}
        </div>
      ))}
    </section>
  </main>
</body>
</html>
